# === NovelCraft env (copy ke .env) ===
# Database MySQL lokal (tanpa Docker — pakai MySQL 8.x yang sudah terinstall)
DATABASE_URL=mysql://root:PASSWORD_KAMU@localhost:3306/novelcraft
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=PASSWORD_KAMU
DB_NAME=novelcraft

# Backend
PORT=3000
JWT_SECRET=ganti-secret-minimal-32-karakter-disini
CORS_ORIGIN=http://localhost:5173

# AI (Fase 6) — opsional. Tanpa ini pun jalan via Mock.
# Kunci server dipakai bila user belum setting kunci sendiri (menu Settings).
# Untuk 9router, isi seperti contoh di bawah (kunci tidak di-commit ke GitHub):
# AI_API_KEY=sk-9router-api-key-anda
# AI_BASE_URL=https://api.9router.com/v1
# AI_MODEL=Combomaut
